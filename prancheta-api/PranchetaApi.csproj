<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PranchetaDatabase</AssemblyName>
    <RootNamespace>PranchetaApi</RootNamespace>
    <Product>Prancheta Database</Product>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- A tela vai embutida no executável: um único arquivo para distribuir. -->
  <ItemGroup>
    <EmbeddedResource Include="..\prancheta.html" LogicalName="prancheta.html" />
  </ItemGroup>

  <!-- Sem .exe próprio: roda pelo dotnet.exe instalado (assinado pela Microsoft). Máquinas com política
       que bloqueia executável não assinado em pasta de usuário rodam a dll normalmente. -->
  <PropertyGroup>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.400" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
  </ItemGroup>

</Project>
